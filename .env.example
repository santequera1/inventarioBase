# ---------- API ----------
NODE_ENV=production
PORT=3300
HOST=127.0.0.1
# URL pública (usada en OpenAPI, enlaces de correo y webhooks)
PUBLIC_URL=https://inventariowilly.botyventas.com
# PostgreSQL
DATABASE_URL=postgresql://inventariowilly:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/inventariowilly?schema=public
# Secreto para firmar cookies de sesión (>= 32 chars aleatorios)
SESSION_SECRET=cambia-esto-por-64-caracteres-aleatorios
# Orígenes CORS permitidos para la API pública (separados por coma, * para todos)
CORS_ORIGINS=https://inventariowilly.botyventas.com
# Carpeta de subida de imágenes
UPLOADS_DIR=./uploads
# Nivel de log de pino
LOG_LEVEL=info
# Zona horaria
TZ=America/Bogota
# Rate limit por API key (peticiones por minuto)
API_RATE_LIMIT=600
